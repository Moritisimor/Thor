<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Thor.MainWindow"
        Title="Thor"
        Width="600"
        Height="400"
        FontFamily="Mono">
        
        <StackPanel>
                <Label Margin="15" HorizontalAlignment="Center" Content="Thor"/>
                <Panel Margin="10,5,0,0">
                        <Label Content="URL"/>
                        <TextBox 
                                Margin="100,0,50,0" 
                                x:Name="UrlTextBox"
                                Background="DimGray"/>
                </Panel>
                
                <Panel Margin="10,5, 0,0">
                        <Label Content="Method"/>
                        <TextBox 
                                Margin="100, 0, 50, 0" 
                                x:Name="MethodTextBox"
                                Background="DimGray"/>
                </Panel>
                
                <Panel Margin="10, 5, 0, 0">
                        <Label Content="Body"/>
                        <TextBox 
                                Margin="100, 0, 50, 0" 
                                x:Name="BodyTextBox"
                                Height="175"
                                Background="DimGray"/>
                </Panel>
                
                <Button 
                        Margin="20"
                        HorizontalAlignment="Center"
                        Content="Send!"
                        x:Name="SendButton"/>
        </StackPanel>
</Window>
